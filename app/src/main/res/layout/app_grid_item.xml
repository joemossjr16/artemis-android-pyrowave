<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="205dp"
    android:layout_margin="6dp"
    android:clickable="false"
    android:focusable="false"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/m3SurfaceContainer"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/m3SurfaceHigh"
    app:strokeWidth="1dp">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:id="@+id/grid_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/m3_image_scrim"
        android:padding="16dp">

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/m3_icon_button_background"
            android:padding="11dp" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:textColor="@color/m3OnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
